<Application x:Class="HongQuant.Platform.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:infrastucture="clr-namespace:HongQuant.Platform.Infrastucture.Drops.Files"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 继续加载 MaterialDesign/MahApps 的行为与 DialogHost，视觉效果统一由终端主题覆盖。 -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="LightBlue" SecondaryColor="LightBlue"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Cyan.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialdesignColor.Lightblue.xaml"/>
                <ResourceDictionary Source="Resources/TerminalLight.xaml"/>
                <ResourceDictionary Source="Resources/TerminalControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="HongQuant.Platform.FontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
            <Style TargetType="{x:Type TextElement}">
                <Setter Property="FontFamily" Value="{StaticResource HongQuant.Platform.FontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
            </Style>
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource HqTextBox}"/>
            <Style x:Key="DatagridCellStyleCenter" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource HqDataGridCell}"/>
            <Style x:Key="DataGridColumnHeaderCenter" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource HqDataGridHeader}"/>
            <DataTemplate DataType="{x:Type infrastucture:FileDropContainer}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDocument" Width="17" Height="17" Margin="0,0,6,0"
                                             Foreground="{DynamicResource Hq.Accent}"/>
                    <ItemsControl ItemsSource="{Binding Files}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
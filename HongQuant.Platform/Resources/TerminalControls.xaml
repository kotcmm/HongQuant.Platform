<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 原生 WPF 组件库：对应附件 components.css。业务页不再依赖第三方主题的控件外观。 -->
    <FontFamily x:Key="Hq.Font">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="Hq.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="HqPageTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
    </Style>
    <Style x:Key="HqSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextFaint}"/>
    </Style>
    <Style x:Key="HqMonoText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Hq.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextMuted}"/>
    </Style>

    <Style x:Key="HqButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Hq.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Hq.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource HqButton}"/>
    <Style x:Key="HqPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource HqButton}">
        <Setter Property="Background" Value="{DynamicResource Hq.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Primary}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="HqGhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource HqButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="HqDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource HqButton}">
        <Setter Property="Foreground" Value="{DynamicResource Hq.Up}"/>
    </Style>
    <Style x:Key="HqTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Hq.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Hq.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource HqTextBox}"/>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Hq.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Hq.TextFaint}"
                                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="Toggle" Background="Transparent" Opacity="0"
                                      Focusable="False" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Hq.Surface}" BorderBrush="{DynamicResource Hq.Border}"
                                    BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, ElementName=Frame}"
                                    MaxHeight="320" Margin="0,3,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Hq.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Hq.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Hq.Surface}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextMuted}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Pill" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Hq.AccentSoft}"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Hq.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hq.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="HqListViewItem" TargetType="{x:Type ListViewItem}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5"
                            Margin="4,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hq.Hover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hq.AccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource HqListViewItem}"/>
    <Style x:Key="HqDataGridCell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Hq.Mono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hq.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Hq.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HqDataGridHeader" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Hq.Header}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextFaint}"/>
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource Hq.Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource Hq.Panel}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Hq.Panel}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CellStyle" Value="{StaticResource HqDataGridCell}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource HqDataGridHeader}"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>
    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hq.RowHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Hq.AccentSoft}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="{DynamicResource Hq.Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="7"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource Hq.Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hq.Border}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextMuted}"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Hq.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HqSidebarTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Hq.TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="39"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="17,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Nav" CornerRadius="5" Margin="8,0" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="2,0,0,0">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Nav" Property="Background" Value="{DynamicResource Hq.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Nav" Property="Background" Value="{DynamicResource Hq.AccentSoft}"/>
                            <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource Hq.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hq.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HqSidebarTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource HqSidebarTabItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{DynamicResource Hq.AppBackground}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="192"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Hq.Sidebar}" BorderBrush="{DynamicResource Hq.Border}" BorderThickness="0,0,1,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="19,25,0,12">
                                    <TextBlock Text="工作空间" FontSize="10" Foreground="{DynamicResource Hq.TextFaint}" Margin="0,0,0,8"/>
                                    <TextBlock Text="研究模块" FontSize="11" Foreground="{DynamicResource Hq.TextMuted}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="17,14">
                                    <Border Background="{DynamicResource Hq.Panel}" BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1"
                                            CornerRadius="6" Padding="11,9">
                                        <StackPanel>
                                            <TextBlock Text="HONG QUANT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Hq.TextMuted}"/>
                                            <TextBlock Text=".NET 8  ·  本地分析" FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource Hq.TextFaint}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TabPanel IsItemsHost="True" Margin="0,8" KeyboardNavigation.TabIndex="1"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource Hq.AppBackground}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
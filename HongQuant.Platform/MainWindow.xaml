<controls:MetroWindow x:Class="HongQuant.Platform.MainWindow"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HongQuant.Platform" 
        xmlns:hong="clr-namespace:HongQuant.Platform.Views.Hong"
        mc:Ignorable="d"
        Title="HONG QUANT"  Height="650" Width="1200" WindowState="Maximized">
    <Window.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="TabItemHeader">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="0.1" Width="{Binding RelativeSource={RelativeSource Self},Path=FontSize}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <TabControl TabStripPlacement="Left" 
            controls:TabControlHelper.Underlined="TabPanel">
            <TabItem Header="鸿观量化" Height="120" Padding="8" HeaderTemplate="{StaticResource TabItemHeader}">
                <hong:HongMain/>
            </TabItem>
            <TabItem Header="易投量化" Height="120" Padding="8" HeaderTemplate="{StaticResource TabItemHeader}"></TabItem>
        </TabControl>
    </Grid>
</controls:MetroWindow>

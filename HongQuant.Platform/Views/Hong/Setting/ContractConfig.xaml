<UserControl x:Class="HongQuant.Platform.Views.Hong.Setting.ContractConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HongQuant.Platform.Views.Hong.Setting"
             xmlns:viewModels="clr-namespace:HongQuant.Platform.ViewModels.Hong.Setting.ContractConfigViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <materialDesign:DialogHost IsOpen="{Binding IsSortContractDialogOpen}">
        <materialDesign:DialogHost.DialogContent>
            <ContentControl Content="{Binding Model}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type viewModels:CreateOrEditContractViewModel}">
                        <StackPanel Margin="16">
                            <TextBlock>输入品种名称.</TextBlock>
                            <TextBox Margin="0 8 0 0" Text="{Binding Key}" materialDesign:HintAssist.Hint="品种简写"/>
                            <TextBox Margin="0 8 0 0" Text="{Binding DefaultName}" materialDesign:HintAssist.Hint="默认名称"/>
                            <StackPanel Orientation="Horizontal" >
                                <TextBox Margin="0 8 0 0" MinWidth="100" Text="{Binding InputOtherName}"
                                     materialDesign:HintAssist.Hint="其他名称"/>
                                <Button Margin="18,8,0,0" Command="{Binding AddOtherNameCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        ToolTip="添加其他名称">
                                    <materialDesign:PackIcon
                                        Kind="CirclesAdd"
                                        Height="24"
                                        Width="24"/>
                                </Button>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding OtherNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0 8 0 0" MinWidth="100" Text="{Binding Mode=OneWay}"/>
                                            <Button Margin="18,8,0,0" 
                                                Command="{Binding Content.DeleteOtherNameCommand,RelativeSource={RelativeSource FindAncestor,AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                ToolTip="删除其他名称">
                                                <materialDesign:PackIcon
                                                    Kind="CloseOctagonOutline"
                                                    Height="24"
                                                    Width="24"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    IsDefault="True"
                                    Margin="0 8 8 0"
                                    Command="{Binding DataContext.AddOrEditContractSubmitCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}">
                                    确定
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    IsCancel="True"
                                    Margin="0 8 8 0"
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                                    <Button.CommandParameter>
                                        <system:Boolean>False</system:Boolean>
                                    </Button.CommandParameter>
                                    取消
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:EditContractTypeViewModel}">
                        <StackPanel Margin="16">
                            <TextBlock>输入板块名称.</TextBlock>
                            <TextBox Margin="0 8 0 0" Text="{Binding Name}" 
                                     materialDesign:HintAssist.Hint="板块名称"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        IsDefault="True"
                                        Margin="0 8 8 0"
                                        Command="{Binding DataContext.TypeEditSubmitCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}">
                                    确定
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    IsCancel="True"
                                    Margin="0 8 8 0"
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                                    <Button.CommandParameter>
                                        <system:Boolean>False</system:Boolean>
                                    </Button.CommandParameter>
                                    取消
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </materialDesign:DialogHost.DialogContent>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="340*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="10,0,10,0" Orientation="Horizontal">
                <TextBox FontSize="18" Width="280"
                 materialDesign:HintAssist.Hint="输入板块名称" 
                 Text="{Binding InputTypeName,UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="添加板块"
                Style="{StaticResource MaterialDesignOutlinedButton}"   
                Margin="30,0,0,0" Width="128"
                Command="{Binding AddTypeCommand}"/>
                <Button Content="导出配置"
                Style="{StaticResource MaterialDesignRaisedSecondaryButton}"   
                Margin="20,0,0,0" Width="128"
                Command="{Binding ExportCommand}"/>
                <Button Content="导入配置"
                Style="{StaticResource MaterialDesignRaisedDarkButton}"   
                Margin="20,0,0,0" Width="128"
                Command="{Binding ImportCommand}"/>
            </StackPanel>

            <TreeView Grid.Row="1" Grid.Column="0" 
              BorderThickness="1" BorderBrush="Black"
              Margin="10" ItemsSource="{Binding ContractTypes}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate 
                        DataType="{x:Type viewModels:ContractTypeViewModel}" 
                        ItemsSource="{Binding Path=Contracts}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5,4,0,0" MinWidth="80" Text="{Binding Name}"/>
                            <Button Margin="10,0,0,0" Command="{Binding DataContext.AddContractCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"
                              CommandParameter="{Binding}"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              ToolTip="添加品种">
                                <materialDesign:PackIcon
                                Kind="CirclesAdd"
                                Height="24"
                                Width="24"/>
                            </Button>
                            <Button Margin="10,0,0,0" 
                                    Command="{Binding DataContext.EditTypeCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="编辑">
                                    <materialDesign:PackIcon
                                        Kind="SquareEditOutline"
                                        Height="24"
                                        Width="24"/>
                            </Button>
                            <Button Margin="0,0,0,0" 
                                    Command="{Binding DataContext.RemoveTypeCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="点击删除" Foreground="Red">
                                    <materialDesign:PackIcon
                                    Kind="DeleteForever"
                                    Height="24"
                                    Width="24"/>
                            </Button>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ContractViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="5,4,0,0" MinWidth="40" Text="{Binding Key}"/>
                            <TextBlock Margin="5,4,0,0" MinWidth="140" Text="{Binding Name}"/>
                            <Button Margin="10,0,0,0" 
                                    Command="{Binding DataContext.EditContractCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="编辑">
                                <materialDesign:PackIcon
                                Kind="SquareEditOutline"
                                Height="24"
                                Width="24"/>
                            </Button>
                            <Button Margin="0,0,0,0" 
                                    Command="{Binding DataContext.RemoveContractCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    ToolTip="点击删除"  Foreground="Red">
                                <materialDesign:PackIcon
                                Kind="DeleteForever"
                                Height="24"
                                Width="24"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>

<UserControl x:Class="HongQuant.Platform.Views.Hong.Shows.SignalDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HongQuant.Platform.Views.Hong.Shows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <ListBox BorderThickness="0,0,1,0" 
                 BorderBrush="{DynamicResource Hq.Border}"
                 ItemsSource="{Binding FileIndexs}"
                 SelectedItem="{Binding FileIndex}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Path}"></TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DataGrid Grid.Column="1" 
                  Background="{DynamicResource Hq.Panel}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  CellStyle="{StaticResource DatagridCellStyleCenter}"
                  ColumnHeaderStyle ="{StaticResource DataGridColumnHeaderCenter}"
                  ItemsSource="{Binding FileIndex.Items}">
            <DataGrid.Resources>
                <Style x:Key="Level" TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="-1">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding SignalDateTime,StringFormat=yyyy年MM月dd日 HH:mm}"/>
                <DataGridTextColumn Header="交易日" Binding="{Binding TradeDate,StringFormat=yyyy年MM月dd日}"/>
                <DataGridTextColumn Header="品种" MinWidth="80" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="权益" MinWidth="80" Binding="{Binding Equity}"/>
                <DataGridTextColumn Header="收益率" MinWidth="80" Binding="{Binding Yields,StringFormat=P2}"/>
                <DataGridTextColumn Header="累计收益率" MinWidth="80" Binding="{Binding TotalYields,StringFormat=P2}"/>
                <DataGridTextColumn Header="实时回撤" MinWidth="80" Binding="{Binding WithdrawDeep,StringFormat=P2}"/>
                <DataGridTextColumn Header="最大回撤" MinWidth="80" Binding="{Binding MaxWithdraw,StringFormat=P2}"/>
                <DataGridTextColumn Header="回撤程度" MinWidth="80" Binding="{Binding WithdrawLevel,StringFormat=P2}"/>
                <DataGridTextColumn Header="潜在风险" MinWidth="80" Binding="{Binding PotentialRisk,StringFormat=P2}"/>
                <DataGridTextColumn Header="日度等级" Binding="{Binding DayLevel}" ElementStyle ="{StaticResource Level}"/>
                <DataGridTextColumn Header="周度等级" Binding="{Binding WeekLevel}" ElementStyle ="{StaticResource Level}"/>
                <DataGridTextColumn Header="月度等级" Binding="{Binding MonthLevel}" ElementStyle ="{StaticResource Level}"/>
                <DataGridTextColumn Header="精准状态">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EntranceState}" Value="Entrance">
                                    <Setter Property="Text" Value="持有"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EntranceState}" Value="Out">
                                    <Setter Property="Text" Value="空闲"/>
                                    <Setter Property="Foreground" Value="Blue"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EntranceState}" Value="Stop">
                                    <Setter Property="Text" Value="止损"/>
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="累计精准收益率" Binding="{Binding AccurateTotalYields,StringFormat=P2}"/>
                <DataGridTextColumn Header="持仓状态">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Direction}" Value="Long">
                                    <Setter Property="Text" Value="多头"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Direction}" Value="Short">
                                    <Setter Property="Text" Value="空头"/>
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Direction}" Value="None">
                                    <Setter Property="Text" Value="平仓"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="持仓盈亏" Binding="{Binding LossEquity}"/>
                <DataGridTextColumn Header="连亏次数" Binding="{Binding LossCount}"/>
                <DataGridTextColumn Header="最大连亏次数" Binding="{Binding MaxLossCount}"/>
                <DataGridTextColumn Header="连亏程度" Binding="{Binding LostDegree,StringFormat=P2}"/>
                <DataGridTextColumn Header="距盈周期" Binding="{Binding PreProfitCycle}"/>
                <DataGridTextColumn Header="最大距盈周期" Binding="{Binding MaxProfitCycle}"/>
                <DataGridTextColumn Header="距盈程度" Binding="{Binding ProfitCycleDegree,StringFormat=P2}"/>
                <DataGridTextColumn Header="空仓周期" Binding="{Binding EmptyCycle}"/>
                <DataGridTextColumn Header="最大空仓周期"  Binding="{Binding MaxEmptyCycle}"/>
                <DataGridTextColumn Header="空仓程度" Binding="{Binding EmptyDegree,StringFormat=P2}"/>
                <DataGridTextColumn Header="持仓周期" Binding="{Binding PositionCycle}"/>
                <DataGridTextColumn Header="最大持仓周期" Binding="{Binding MaxPositionCycle}"/>
                <DataGridTextColumn Header="持仓程度" Binding="{Binding PositionDegree,StringFormat=P2}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<UserControl x:Class="HongQuant.Platform.Views.RealTime.RealTimeMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HongQuant.Platform.Views.RealTime"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="4">
            <Button Command="{Binding StartCommand}">开始</Button>
            <Button Command="{Binding AnalysisCommand}">统计</Button>
            <Button Command="{Binding ProductPoolCommand}">品种池</Button>
        </StackPanel>
        <TabControl TabStripPlacement="Bottom" 
                    BorderThickness="0,1,0,1" 
                    BorderBrush="{DynamicResource Hq.Border}"  
                    Grid.Row="1">
            <TabItem Header="单品种">
                <local:ProductListView/>
            </TabItem>
            <TabItem Header="组合品种">
                <local:CombProductListView/>
            </TabItem>
        </TabControl>
        
    </Grid>
</UserControl>

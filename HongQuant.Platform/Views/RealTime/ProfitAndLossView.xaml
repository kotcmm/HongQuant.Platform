<UserControl x:Class="HongQuant.Platform.Views.RealTime.ProfitAndLossView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HongQuant.Platform.Views.RealTime"
             xmlns:items="clr-namespace:HongQuant.Platform.ViewModels.RealTime.Items"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border BorderBrush="LightBlue" BorderThickness="2">
            <lvc:CartesianChart
                Series="{Binding Series}" 
                XAxes="{Binding XAxes}"
                YAxes="{Binding YAxes}"
                TooltipPosition="Hidden"
                ZoomMode="None"/>
        </Border>
        
        <lvc:CartesianChart Grid.Row="1"
            Series="{Binding DaySeries}" 
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            TooltipPosition="Hidden"
            ZoomMode="None"/>
        <Border BorderBrush="LightBlue" BorderThickness="2" Grid.Row="2">
            <lvc:CartesianChart 
            Series="{Binding WeekSeries}" 
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            TooltipPosition="Hidden"
            ZoomMode="None" Background="Black"/>
        </Border>
        <lvc:CartesianChart Grid.Row="3"
            Series="{Binding MonthSeries}" 
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            TooltipPosition="Hidden"
            ZoomMode="None"/>
    </Grid>
</UserControl>

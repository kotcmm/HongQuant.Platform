<mah:MetroWindow x:Class="HongQuant.Platform.Views.RealTime.ProductPoolView"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HongQuant.Platform.Views.RealTime"
        mc:Ignorable="d"
        Title="品种池编辑" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Margin="10" Orientation="Horizontal" VerticalAlignment="Center">
            <Label>组合名称：</Label>
            <TextBox Width="120" Text="{Binding Pool.Name}"></TextBox>
            <Label Margin="20 0 0 0">品种列表：</Label>
            <TextBox Width="320" Text="{Binding Pool.Products}"></TextBox>
            <Button Margin="20 0 0 0"
                    Command="{Binding AddOrUpdateCommand}">保存</Button>
        </StackPanel>
        <DataGrid Background="{DynamicResource Hq.Panel}" Grid.Row="1"
               AutoGenerateColumns="False" 
               CanUserAddRows="False"
               CellStyle="{StaticResource DatagridCellStyleCenter}"
               ColumnHeaderStyle ="{StaticResource DataGridColumnHeaderCenter}"
               ItemsSource="{Binding ProductPools}"
               SelectedItem="{Binding Pool}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="组合名称" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="品种列表" MinWidth="400" Binding="{Binding Products}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="操作" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="18 0 0 0" Content="删除"
                                Foreground="{DynamicResource Hq.Up}"
                                Height="20"
                                Padding="0"
                                Style="{StaticResource HqButton}"
                                Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</mah:MetroWindow>

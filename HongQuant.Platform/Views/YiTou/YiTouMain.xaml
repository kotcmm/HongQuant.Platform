                    <GridViewColumn Width="160" Header="累计收益%" DisplayMemberBinding="{Binding Total,StringFormat=F2}"/>
                    <GridViewColumn Width="160" Header="最大回撤%" DisplayMemberBinding="{Binding MaxRetracement,StringFormat=F2}"/>
                    <GridViewColumn Width="140" Header="回撤日期" DisplayMemberBinding="{Binding RetracementDate,StringFormat=yyyyMMdd}"/>
                    <GridViewColumn Width="160" Header="最大收益%" DisplayMemberBinding="{Binding MaxTotal,StringFormat=F2}"/>
                    <GridViewColumn Width="140" Header="收益日期" DisplayMemberBinding="{Binding MaxTotalDate,StringFormat=yyyyMMdd}"/>

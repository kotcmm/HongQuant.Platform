<UserControl x:Class="HongQuant.Platform.Views.YiTou.YiTouMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infrastucture="clr-namespace:HongQuant.Platform.Infrastucture.Drops.Files" 
             xmlns:configs="clr-namespace:HongQuant.Platform.Views.YiTou.Configs"
             xmlns:viewModels="clr-namespace:HongQuant.Platform.ViewModels.YiTou.Configs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid infrastucture:DependencyObjectHook.Receiver="{Binding DropMonitor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <ScrollViewer Margin="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding CombinationFileIndexs}"
                          SelectedItem="{Binding SelectFileIndex}"
                          DisplayMemberPath="Name" 
                          Margin="10 0 0 0" 
                          Padding="28 0 0 0"
                          Width="140"
                          HorizontalContentAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="10 0 0 0" Content="导入数据" 
                        Command="{Binding OpenFileCommand}" ></Button>
                <ComboBox ItemsSource="{Binding AlgorithmTypes}"
                  SelectedItem="{Binding SelectAlgorithmType}"
                  DisplayMemberPath="Name" 
                  Margin="10 0 0 0" 
                  Padding="28 0 0 0"
                  Width="140"
                  HorizontalContentAlignment="Center"/>

                <ContentControl Content="{Binding Config}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type viewModels:CycleConfigIncomeViewModel}">
                            <configs:CycleConfig DataContext="{Binding}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:Multiple5ConfigIncomeViewModel}">
                            <configs:Multiple5Config DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10 0 0 0" Content="导出数据" Command="{Binding SaveFileCommand}"></Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10 0 0 0" Content="图表分析" Command="{Binding BarChartCommand}"></Button>
        </StackPanel>
        </ScrollViewer>
        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0 0 0 1" />
        <DataGrid Grid.Row="1" 
              Background="White"
              AutoGenerateColumns="False" 
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserSortColumns="False"
              CellStyle="{StaticResource DatagridCellStyleCenter}"
              ColumnHeaderStyle ="{StaticResource DataGridColumnHeaderCenter}"
              ItemsSource="{Binding IncomeStatistics}" 
              SelectedItem="{Binding IncomeStatistic}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="140" Header="开始日期" Binding="{Binding Start,StringFormat=yyyyMMdd}"/>
                <DataGridTextColumn Width="140" Header="结束日期" Binding="{Binding End,StringFormat=yyyyMMdd}"/>
                <DataGridTextColumn Width="160" Header="累计收益%" Binding="{Binding Total,StringFormat=F2}"/>
                <DataGridTextColumn Width="160" Header="最大回撤%" Binding="{Binding MaxRetracement,StringFormat=F2}"/>
                <DataGridTextColumn Width="140" Header="回撤日期" Binding="{Binding RetracementDate,StringFormat=yyyyMMdd}"/>
                <DataGridTextColumn Width="160" Header="最大收益%" Binding="{Binding MaxTotal,StringFormat=F2}"/>
                <DataGridTextColumn Width="140" Header="收益日期" Binding="{Binding MaxTotalDate,StringFormat=yyyyMMdd}"/>
                <DataGridTextColumn Width="140" Header="交易天数" Binding="{Binding DayCount}"/>
                <DataGridTextColumn Width="140" Header="累计杠杆" Binding="{Binding LastMultiples}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

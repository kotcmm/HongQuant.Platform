<UserControl x:Class="HongQuant.Platform.Views.YiTou.YiTouMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastucture="clr-namespace:HongQuant.Platform.Infrastucture.Drops.Files"
             xmlns:configs="clr-namespace:HongQuant.Platform.Views.YiTou.Configs"
             xmlns:viewModels="clr-namespace:HongQuant.Platform.ViewModels.YiTou.Configs">
    <Grid infrastucture:DependencyObjectHook.Receiver="{Binding DropMonitor}"
          Background="{DynamicResource Hq.AppBackground}" Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,17">
            <TextBlock Text="策略收益分析" Style="{StaticResource HqPageTitle}"/>
            <TextBlock Text="读取基础数据的组合样本  /  选择算法并调整参数即可重新计算"
                       Style="{StaticResource HqSubtitle}" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Hq.Panel}" BorderBrush="{DynamicResource Hq.Border}"
                BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,11">
                    <TextBlock DockPanel.Dock="Left" Text="计算参数" FontWeight="SemiBold"
                               FontSize="12.5" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="导出数据" Command="{Binding SaveFileCommand}"/>
                        <Button Content="图表分析" Style="{StaticResource HqPrimaryButton}"
                                Margin="0" Command="{Binding BarChartCommand}"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
                        <TextBlock Text="数据组合" VerticalAlignment="Center" Foreground="{DynamicResource Hq.TextMuted}" Margin="0,0,8,0"/>
                        <ComboBox Width="165" ItemsSource="{Binding CombinationFileIndexs}" SelectedItem="{Binding SelectFileIndex}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
                        <TextBlock Text="算法类型" VerticalAlignment="Center" Foreground="{DynamicResource Hq.TextMuted}" Margin="0,0,8,0"/>
                        <ComboBox Width="134" ItemsSource="{Binding AlgorithmTypes}" SelectedItem="{Binding SelectAlgorithmType}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <ContentControl Content="{Binding Config}" VerticalAlignment="Center" Margin="0,0,0,8">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:CycleConfigIncomeViewModel}">
                                <configs:CycleConfig DataContext="{Binding}"/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type viewModels:Multiple5ConfigIncomeViewModel}">
                                <configs:Multiple5Config DataContext="{Binding}"/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 三张统计指标卡全部来自当前选中的真实统计行 -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
            <Border Background="{DynamicResource Hq.Panel}" BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1"
                    CornerRadius="9" Padding="15,11" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="累计收益" Style="{StaticResource HqSubtitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding IncomeStatistic.Total,StringFormat=F2,TargetNullValue=—}"
                                   FontSize="22" FontFamily="{StaticResource Hq.Mono}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Hq.Up}"/>
                        <TextBlock Text="%" VerticalAlignment="Bottom" Margin="5,0,0,3"
                                   Foreground="{DynamicResource Hq.TextFaint}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Hq.Panel}" BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1"
                    CornerRadius="9" Padding="15,11" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="最大回撤" Style="{StaticResource HqSubtitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding IncomeStatistic.MaxRetracement,StringFormat=F2,TargetNullValue=—}"
                                   FontSize="22" FontFamily="{StaticResource Hq.Mono}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Hq.TextMuted}"/>
                        <TextBlock Text="%" VerticalAlignment="Bottom" Margin="5,0,0,3"
                                   Foreground="{DynamicResource Hq.TextFaint}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Hq.Panel}" BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1"
                    CornerRadius="9" Padding="15,11">
                <StackPanel>
                    <TextBlock Text="最大收益" Style="{StaticResource HqSubtitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding IncomeStatistic.MaxTotal,StringFormat=F2,TargetNullValue=—}"
                                   FontSize="22" FontFamily="{StaticResource Hq.Mono}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Hq.Up}"/>
                        <TextBlock Text="%" VerticalAlignment="Bottom" Margin="5,0,0,3"
                                   Foreground="{DynamicResource Hq.TextFaint}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="3" Background="{DynamicResource Hq.Panel}" BorderBrush="{DynamicResource Hq.Border}"
                BorderThickness="1" CornerRadius="9" ClipToBounds="True">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Hq.Header}"
                        BorderBrush="{DynamicResource Hq.Border}" BorderThickness="0,0,0,1" Padding="14,11">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="收益统计" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Margin="12,1,0,0" Foreground="{DynamicResource Hq.TextFaint}"
                                   Text="{Binding IncomeStatistics.Count,StringFormat='共 {0} 期'}"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding IncomeStatistics}" SelectedItem="{Binding IncomeStatistic}"
                          IsReadOnly="True" BorderThickness="0" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          CellStyle="{StaticResource DatagridCellStyleCenter}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderCenter}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="110" Header="开始日期" Binding="{Binding Start,StringFormat=yyyyMMdd}"/>
                        <DataGridTextColumn Width="110" Header="结束日期" Binding="{Binding End,StringFormat=yyyyMMdd}"/>
                        <DataGridTextColumn Width="118" Header="累计收益%" Binding="{Binding Total,StringFormat=F2}"/>
                        <DataGridTextColumn Width="118" Header="最大回撤%" Binding="{Binding MaxRetracement,StringFormat=F2}"/>
                        <DataGridTextColumn Width="110" Header="回撤日期" Binding="{Binding RetracementDate,StringFormat=yyyyMMdd}"/>
                        <DataGridTextColumn Width="118" Header="最大收益%" Binding="{Binding MaxTotal,StringFormat=F2}"/>
                        <DataGridTextColumn Width="110" Header="收益日期" Binding="{Binding MaxTotalDate,StringFormat=yyyyMMdd}"/>
                        <DataGridTextColumn Width="100" Header="交易天数" Binding="{Binding DayCount}"/>
                        <DataGridTextColumn Width="110" Header="累计杠杆" Binding="{Binding LastMultiples}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
<UserControl x:Class="HongQuant.Platform.Views.YiTou.Configs.CycleConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="结算周期" Foreground="{DynamicResource Hq.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Text="{Binding Month,UpdateSourceTrigger=PropertyChanged}" Width="62"
                 HorizontalContentAlignment="Center"/>
        <TextBlock Text="个月" Foreground="{DynamicResource Hq.TextFaint}" VerticalAlignment="Center" Margin="7,0,0,0"/>
    </StackPanel>
</UserControl>
<UserControl x:Class="HongQuant.Platform.Views.YiTou.Configs.CycleConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HongQuant.Platform.Views.YiTou.Configs"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <TextBlock Padding="10 14 0 0">结算周期：</TextBlock>
            <TextBox HorizontalContentAlignment="Center" Text="{Binding Month,UpdateSourceTrigger=PropertyChanged}" Width="60" Height="30"></TextBox>
            <TextBlock Padding="0 14 0 0">个月</TextBlock>
        </StackPanel>
    </Grid>
</UserControl>

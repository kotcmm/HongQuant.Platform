<UserControl x:Class="HongQuant.Platform.Views.YiTou.Configs.Multiple5Config"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
            <CheckBox IsChecked="{Binding UseIncome,UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="目标收益 %" Foreground="{DynamicResource Hq.TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox Text="{Binding MaxIncome,UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
            <CheckBox IsChecked="{Binding UseTime,UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="目标时间(月)" Foreground="{DynamicResource Hq.TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox Text="{Binding MaxTime,UpdateSourceTrigger=PropertyChanged}" Width="58" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
            <TextBlock Text="初始杠杆" Foreground="{DynamicResource Hq.TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox Text="{Binding Start,UpdateSourceTrigger=PropertyChanged}" Width="58" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
            <TextBlock Text="杠杆增量" Foreground="{DynamicResource Hq.TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox Text="{Binding Increment,UpdateSourceTrigger=PropertyChanged}" Width="58" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
            <TextBlock Text="杠杆上限" Foreground="{DynamicResource Hq.TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox Text="{Binding Max,UpdateSourceTrigger=PropertyChanged}" Width="58" HorizontalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
            <TextBlock Text="间隔(月)" Foreground="{DynamicResource Hq.TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox Text="{Binding Month,UpdateSourceTrigger=PropertyChanged}" Width="58" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </WrapPanel>
</UserControl>
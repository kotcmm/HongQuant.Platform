<UserControl x:Class="HongQuant.Platform.Views.YiTou.ChartViews.SampleChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HongQuant.Platform.Views.YiTou.ChartViews"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:view="clr-namespace:HongQuant.Platform.Views.YiTou"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <view:IntToBoolConverter x:Key="IntToBoolConverter"></view:IntToBoolConverter>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Margin="10 0 0 0" Orientation="Horizontal">
                <RadioButton Content="累计收益" IsChecked="{Binding ShowField,Converter={StaticResource IntToBoolConverter},ConverterParameter=0}"/>
                <RadioButton Margin="10 0 0 0" Content="最大回撤" IsChecked="{Binding ShowField,Converter={StaticResource IntToBoolConverter},ConverterParameter=1}"/>
                <RadioButton Margin="10 0 0 0" Content="最大收益" IsChecked="{Binding ShowField,Converter={StaticResource IntToBoolConverter},ConverterParameter=2}"/>
                <RadioButton Margin="10 0 0 0" Content="交易天数" IsChecked="{Binding ShowField,Converter={StaticResource IntToBoolConverter},ConverterParameter=3}"/>
                <RadioButton Margin="10 0 0 0" Content="累计杠杆" IsChecked="{Binding ShowField,Converter={StaticResource IntToBoolConverter},ConverterParameter=4}"/>
            </StackPanel>
            <lvc:CartesianChart 
                Series="{Binding TotalSeries}"
                XAxes="{Binding TotalXAxes}"
                ZoomMode="X" 
                Grid.Row="1" />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="HongQuant.Platform.Views.Original.ShowCharts.YieldsChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:HongQuant.Platform.Views.Original.ShowCharts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Margin="10 0 0 0" Orientation="Horizontal">
            <RadioButton Margin="10 0 0 0" 
                 IsChecked="True"
                 Content="年度" 
                 Command="{Binding FieldChangeCommand}"
                 CommandParameter="1"/>
            <RadioButton Margin="10 0 0 0" 
                 Content="月度" 
                 Command="{Binding FieldChangeCommand}"
                 CommandParameter="2"/>
            <RadioButton Margin="10 0 0 0" 
                 Content="日度" 
                 Command="{Binding FieldChangeCommand}"
                 CommandParameter="3"/>
        </StackPanel>
        <lvc:CartesianChart 
            Series="{Binding TotalSeries}"
            XAxes="{Binding TotalXAxes}"
            YAxes="{Binding TotalYAxes}"
            ZoomMode="X" 
            Grid.Row="1" />
    </Grid>
</UserControl>

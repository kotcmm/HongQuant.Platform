<mah:MetroWindow x:Class="HongQuant.Platform.Views.Original.ShowChartView"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:HongQuant.Platform.Views.Original"
        mc:Ignorable="d"
        Title="图表展示" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Margin="10 0 0 0" Orientation="Horizontal">
            <RadioButton Content="净利润"
                         IsChecked="True"
                         BorderBrush="{DynamicResource Theme.ShowcaseBrush}"
                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                         Command="{Binding FieldChangeCommand}"
                         CommandParameter="0"/>
            <RadioButton Margin="10 0 0 0" 
                         Content="收益率" 
                         BorderBrush="{DynamicResource Theme.ShowcaseBrush}"
                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}" 
                         Command="{Binding FieldChangeCommand}"
                         CommandParameter="1"/>
            <RadioButton Margin="10 0 0 0" 
                         Content="累计收益率" 
                         BorderBrush="{DynamicResource Theme.ShowcaseBrush}"
                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                         Command="{Binding FieldChangeCommand}"
                         CommandParameter="2"/>
            <RadioButton Margin="10 0 0 0" 
                         Content="实时回撤" 
                         BorderBrush="{DynamicResource Theme.ShowcaseBrush}"
                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                         Command="{Binding FieldChangeCommand}"
                         CommandParameter="3"/>
            <RadioButton Margin="10 0 0 0" 
                         Content="最大回撤" 
                         BorderBrush="{DynamicResource Theme.ShowcaseBrush}"
                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                         Command="{Binding FieldChangeCommand}"
                         CommandParameter="4"/>
        </StackPanel>
        <lvc:CartesianChart 
            Series="{Binding TotalSeries}"
            XAxes="{Binding TotalXAxes}"
            ZoomMode="X" 
            Grid.Row="1" />
    </Grid>
</mah:MetroWindow>

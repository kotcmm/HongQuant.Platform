<mah:MetroWindow x:Class="HongQuant.Platform.Views.Original.ProductTemplateSettingView"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HongQuant.Platform.Views.Original"
        mc:Ignorable="d"
        Title="品种组合配置" Height="450" Width="800">
    <Grid>
        <DataGrid Background="White"
               AutoGenerateColumns="False" 
               ItemsSource="{Binding ProductTemplates}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="组合名称" Binding="{Binding TemplateName}"/>
                <DataGridTextColumn Header="品种列表" Binding="{Binding Products}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</mah:MetroWindow>

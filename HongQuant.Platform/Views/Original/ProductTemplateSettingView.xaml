<Window x:Class="HongQuant.Platform.Views.Original.ProductTemplateSettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="组合模板管理"
        Width="960" Height="550" MinWidth="740" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="#F1F3F7" AllowsTransparency="False"
        FontFamily="{StaticResource Hq.Font}" FontSize="12">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="1" CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TemplateWindowAction" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#68768A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E7ECF5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D9E4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TemplateCloseAction" TargetType="{x:Type Button}" BasedOn="{StaticResource TemplateWindowAction}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#C50F1F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TemplateGridCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource HqDataGridCell}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="{StaticResource Hq.Font}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="TemplateGridHeader" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource HqDataGridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#BBC7D8" BorderThickness="1" CornerRadius="8" Background="#F1F3F7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 原生 WPF 标题栏，与主窗口一致；不用 MahApps 蓝色标题栏。 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E6EE" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                            Background="#477BE6" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Path Width="15" Height="15" Stroke="White" StrokeThickness="1.4"
                              Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M2,3 H13 V12 H2 Z M5.6,3 V12 M2,6 H13"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="组合模板管理" Foreground="#17243B" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="HONG QUANT · RESEARCH TERMINAL" Foreground="#8795AA" FontSize="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="最小化" Style="{StaticResource TemplateWindowAction}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
                            <Path Width="16" Height="16" Data="M3,8.5 L13,8.5" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25"/>
                        </Button>
                        <Button ToolTip="最大化/还原" Style="{StaticResource TemplateWindowAction}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click">
                            <Grid Width="16" Height="16">
                                <Path Data="M3.5,3.5 H12.5 V12.5 H3.5 Z" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="Maximized">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="M5,3.5 H12.5 V11 H10.5 M3.5,5.5 H10.5 V12.5 H3.5 Z" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="Maximized">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button ToolTip="关闭" Style="{StaticResource TemplateCloseAction}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                            <Path Width="16" Height="16" Data="M4,4 L12,12 M12,4 L4,12"
                                  Stretch="Uniform" StrokeThickness="1.4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="组合模板" Foreground="#17243B" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="可修改组合名称、保存更改或删除模板；品种清单仅供查看。"
                               Foreground="#8190A7" FontSize="11.5" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="8" Background="White" BorderBrush="#E2E6EE"
                        BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding ProductTemplates}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" HeadersVisibility="Column"
                              RowHeight="48" ColumnHeaderHeight="40" BorderThickness="0"
                              Background="White" RowBackground="White"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F5"
                              CellStyle="{StaticResource TemplateGridCell}"
                              ColumnHeaderStyle="{StaticResource TemplateGridHeader}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="组合名称" Width="200" MinWidth="160" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TemplateName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource HqTextBox}" Height="30"
                                                 ToolTip="修改后点击右侧保存"
                                                 VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="品种清单" Width="*" MinWidth="220" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Products}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Products}" Foreground="#65748C"
                                                   FontSize="11.5" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="158" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Button Content="保存" Width="62" Height="29" Margin="0,0,6,0"
                                                    Padding="0" Style="{StaticResource HqPrimaryButton}"
                                                    IsEnabled="{Binding IsEditing}"
                                                    Command="{Binding DataContext.SaveCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Width="62" Height="29" Padding="0" Margin="0"
                                                    Style="{StaticResource HqDangerButton}"
                                                    Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="编辑名称后保存，删除操作需要再次确认。" Foreground="#91A0B2"
                               FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Content="关闭" Width="84" Height="31" Padding="0" Margin="0"
                            Style="{StaticResource HqButton}" DockPanel.Dock="Right"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </DockPanel>
            </Grid>

            <!-- 删除确认采用与终端一致的内嵌浮层，不再弹出 MahApps 蓝色窗口。 -->
            <Grid x:Name="DeleteConfirmationOverlay" Grid.RowSpan="2"
                  Visibility="Collapsed" Background="#660B1525">
                <Border Width="385" MaxWidth="385" Padding="20" CornerRadius="10"
                        BorderBrush="#D9E1ED" BorderThickness="1"
                        Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="删除组合模板" Foreground="#17243B" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="DeleteConfirmationMessage" Margin="0,12,0,18"
                                   TextWrapping="Wrap" Foreground="#68768A" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelDeleteButton" Content="取消" Width="84" Height="32"
                                    Margin="0,0,8,0" Padding="0"
                                    Style="{StaticResource HqButton}" Click="CancelDelete_Click"/>
                            <Button Content="确认删除" Width="92" Height="32" Padding="0" Margin="0"
                                    Style="{StaticResource HqDangerButton}" Click="ConfirmDelete_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
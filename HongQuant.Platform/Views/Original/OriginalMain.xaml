<UserControl x:Class="HongQuant.Platform.Views.Original.OriginalMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HongQuant.Platform.Views.Original"
             xmlns:infrastucture="clr-namespace:HongQuant.Platform.Infrastucture.Drops.Files">
    <Grid infrastucture:DependencyObjectHook.Receiver="{Binding DropMonitor}"
          Background="{DynamicResource Hq.AppBackground}" Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,17">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="基础数据" Style="{StaticResource HqPageTitle}"/>
                <TextBlock Text="回测权益明细  /  策略数据管理与组合分析" Style="{StaticResource HqSubtitle}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource Hq.Panel}"
                BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1" Padding="13,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="更新数据" Command="{Binding RefreshFilesCommand}"
                            Style="{StaticResource HqPrimaryButton}"/>
                    <Button Content="编辑模板" Command="{Binding OpenProductTemplateSettingCommand}"/>
                    <Button Content="导出数据" Command="{Binding ExportCommand}"/>
                    <Button Content="数据路径" Command="{Binding OpenFolderCommand}"
                            ToolTip="{Binding FolderPath}" Style="{StaticResource HqGhostButton}"/>
                </StackPanel>
                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsTemplateSync}"
                          Content="同步组合" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Hq.Panel}"
                BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
            <local:ShowDataView/>
        </Border>
    </Grid>
</UserControl>
<UserControl x:Class="HongQuant.Platform.Views.Original.OriginalMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HongQuant.Platform.Views.Original"
             xmlns:infrastucture="clr-namespace:HongQuant.Platform.Infrastucture.Drops.Files" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid infrastucture:DependencyObjectHook.Receiver="{Binding DropMonitor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" Margin="8" Cursor="Hand">
                <Button 
                    ToolTip="{Binding FolderPath}"
                    Command="{Binding OpenFolderCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    文件夹路径
                </Button>
                <CheckBox IsChecked="{Binding IsTemplateSync}">同步组合</CheckBox>
                <Button 
                    Command="{Binding RefreshFilesCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    更新数据
                </Button>
                <Button 
                    Command="{Binding OpenProductTemplateSettingCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    编辑模板
                </Button>
                <Button 
                    Command="{Binding ExportCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    导出数据
                </Button>
            </StackPanel>
            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0 0 0 1" />
        </Grid>
        <local:ShowDataView Grid.Row="1"/>
    </Grid>
</UserControl>

<mah:MetroWindow Background="{DynamicResource Hq.AppBackground}" Foreground="{DynamicResource Hq.Text}" x:Class="HongQuant.Platform.Views.Original.ShowLastView"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HongQuant.Platform.Views.Original"
        mc:Ignorable="d"
        Title="最新数据" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding PreCommand}">上一条</Button>
            <Button Command="{Binding NextCommand}">下一条</Button>
            <Button Command="{Binding LastCommand}">最新条</Button>
        </StackPanel>
        <DataGrid
            Grid.Row="1"
            Background="{DynamicResource Hq.Panel}"
            AutoGenerateColumns="False" 
            IsReadOnly="True"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CellStyle="{StaticResource DatagridCellStyleCenter}"
            ColumnHeaderStyle ="{StaticResource DataGridColumnHeaderCenter}"
            ItemsSource="{Binding LastItems}">
            <DataGrid.Columns>
                <!--<DataGridTextColumn Header="时间" Binding="{Binding SignalDateTime,StringFormat=yyyy年MM月dd日 HH:mm}"/>-->
                <DataGridTextColumn Header="品种" Binding="{Binding Product}"/>
                <DataGridTextColumn Header="交易日" Binding="{Binding TradeDate,StringFormat=yyyy年MM月dd日}"/>
                <DataGridTextColumn Header="权益" MinWidth="80" Binding="{Binding Equity,StringFormat=F2}"/>
                <DataGridTextColumn Header="净利润" MinWidth="80" Binding="{Binding TodayProfitAndLoss}"/>
                <DataGridTextColumn Header="收益率" MinWidth="80" Binding="{Binding Yields,StringFormat=P2}"/>
                <DataGridTextColumn Header="累计收益率" MinWidth="80" Binding="{Binding TotalYields,StringFormat=P2}"/>
                <DataGridTextColumn Header="实时回撤" MinWidth="80" Binding="{Binding WithdrawDeep,StringFormat=P2}"/>
                <DataGridTextColumn Header="最大回撤" MinWidth="80" Binding="{Binding MaxWithdraw,StringFormat=P2}"/>
                <DataGridTextColumn Header="回撤程度" MinWidth="80" Binding="{Binding WithdrawLevel,StringFormat=P2}"/>
                <DataGridTextColumn Header="持仓" MinWidth="80" Binding="{Binding Position}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</mah:MetroWindow>

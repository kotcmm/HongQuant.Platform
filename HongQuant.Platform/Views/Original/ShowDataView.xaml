<UserControl x:Class="HongQuant.Platform.Views.Original.ShowDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:view="clr-namespace:HongQuant.Platform.Views.Original"
             xmlns:system="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <view:TypeToBoolConverter x:Key="TypeToBoolConverter"/>
    </UserControl.Resources>
    <materialDesign:DialogHost IsOpen="{Binding IsTemplateDialogOpen}">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="{DynamicResource Hq.Panel}" Padding="20"
                    BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1" CornerRadius="9">
                <StackPanel MinWidth="310">
                    <TextBlock Text="保存品种组合" Style="{StaticResource HqPageTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="将当前已勾选的品种保存为可复用的组合模板"
                               Style="{StaticResource HqSubtitle}" Margin="0,0,0,14"/>
                    <TextBox Text="{Binding TemplateName,UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="模板名字"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="取消" IsCancel="True" Style="{StaticResource HqGhostButton}"
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                            <Button.CommandParameter><system:Boolean>False</system:Boolean></Button.CommandParameter>
                        </Button>
                        <Button Content="保存模板" IsDefault="True" Style="{StaticResource HqPrimaryButton}"
                                Margin="0" Command="{Binding DataContext.SaveTemplateCommand,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type UserControl}}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 品种池：过滤条件 / 列表 / 模板选择 -->
            <Border Grid.Column="0" Background="{DynamicResource Hq.Sidebar}" BorderBrush="{DynamicResource Hq.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="11,13,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="品种池" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FileIndexs.Count,StringFormat='已列出 {0}'}"
                                   Style="{StaticResource HqSubtitle}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="策略筛选" Style="{StaticResource HqSubtitle}" Margin="4,0,0,5"/>
                        <TextBox Text="{Binding Strategy,UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="多个策略使用英文逗号分隔"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="品种筛选" Style="{StaticResource HqSubtitle}" Margin="4,0,0,5"/>
                        <TextBox Text="{Binding Product,UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="多个品种使用英文逗号分隔"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="{DynamicResource Hq.Panel}" CornerRadius="6"
                            BorderBrush="{DynamicResource Hq.Border}" BorderThickness="1" ClipToBounds="True">
                        <ListView ItemsSource="{Binding FileIndexs}" SelectedItem="{Binding FileIndex}">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="组合计算" Command="{Binding CombinationCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="最新查看" Command="{Binding ShowLastCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="保存模板" Command="{Binding OpenSaveTemplateCommand}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource HqListViewItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Hq.Mono}" FontSize="11"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="组合模板" Style="{StaticResource HqSubtitle}" Margin="4,0,0,5"/>
                        <ComboBox ItemsSource="{Binding ProductTemplates}" SelectedItem="{Binding SelectProductTemplate}"
                                  DisplayMemberPath="TemplateName"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 数据表与下方多品种页签保留现有绑定及命令 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="43"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="44"/>
                </Grid.RowDefinitions>
                <DockPanel Background="{DynamicResource Hq.Panel}" Margin="14,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="权益明细" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="{Binding SelectFileIndex.Name}" Margin="12,1,0,0" FontSize="11"
                                   Foreground="{DynamicResource Hq.TextFaint}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="查看图表" Command="{Binding ShowChartCommand}" Height="28"/>
                        <Button Content="导出数据" Command="{Binding ExportCommand}" Height="28" Margin="0"
                                Style="{StaticResource HqGhostButton}"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" Margin="0" ItemsSource="{Binding SelectFileIndex.Items}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          BorderThickness="0,1,0,1" CellStyle="{StaticResource DatagridCellStyleCenter}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderCenter}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="查看图表" Command="{Binding ShowChartCommand}"/>
                            <Separator/>
                            <MenuItem Header="导出数据" Command="{Binding ExportCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                            <DataGridTextColumn Header="品种" Width="105" Binding="{Binding Product}"/>
                            <DataGridTextColumn Header="交易日" Width="128" Binding="{Binding TradeDate,StringFormat=yyyy-MM-dd}"/>
                            <DataGridTextColumn Header="权益" Width="110" Binding="{Binding Equity,StringFormat=F0}"/>
                            <DataGridTextColumn Header="净利润" Width="112" Binding="{Binding TodayProfitAndLoss}"/>
                            <DataGridTextColumn Header="收益率" Width="106" Binding="{Binding Yields,StringFormat=P2}"/>
                            <DataGridTextColumn Header="累计收益率" Width="118" Binding="{Binding TotalYields,StringFormat=P2}"/>
                            <DataGridTextColumn Header="实时回撤" Width="110" Binding="{Binding WithdrawDeep,StringFormat=P2}"/>
                            <DataGridTextColumn Header="最大回撤" Width="110" Binding="{Binding MaxWithdraw,StringFormat=P2}"/>
                            <DataGridTextColumn Header="回撤程度" Width="110" Binding="{Binding WithdrawLevel,StringFormat=P2}"/>
                            <DataGridTextColumn Header="持仓(总/多/空)" Width="142" Binding="{Binding PositionFormat}"/>
                            <DataGridTextColumn Header="上轨" Width="100" Binding="{Binding MaxEquity,StringFormat=F0}"/>
                            <DataGridTextColumn Header="中轨" Width="100" Binding="{Binding AvgEquity,StringFormat=F0}"/>
                            <DataGridTextColumn Header="下轨" Width="100" Binding="{Binding MinEquity,StringFormat=F0}"/>
                            <DataGridTextColumn Header="信号" Width="88" Binding="{Binding HasSignal}"/>
                            <DataGridTextColumn Header="累计收益" Width="112" Binding="{Binding TotalProfit,StringFormat=F0}"/>
                            <DataGridTextColumn Header="累计信号收益" Width="135" Binding="{Binding TotalSignalProfit,StringFormat=F0}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="{DynamicResource Hq.Header}"
                        BorderBrush="{DynamicResource Hq.Border}" BorderThickness="0,1,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="12,5">
                            <RadioButton Content="单个品种" ToolTip="{Binding FileIndex.Name}"
                                         Command="{Binding TabChangeCommand}" CommandParameter="{Binding FileIndex}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource TypeToBoolConverter}" ConverterParameter="1">
                                        <Binding Path="SelectFileIndex" Mode="OneWay"/>
                                        <Binding Path="FileIndex" Mode="OneWay"/>
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                            <ItemsControl ItemsSource="{Binding CombinationFileIndexs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Command="{Binding DataContext.TabChangeCommand,RelativeSource={RelativeSource FindAncestor,AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Button Content="×" ToolTip="关闭组合" Width="20" MinWidth="20" Height="23" Padding="0"
                                                        Margin="6,0,0,0" Style="{StaticResource HqGhostButton}"
                                                        Command="{Binding DataContext.CloseCommand,RelativeSource={RelativeSource FindAncestor,AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource TypeToBoolConverter}" ConverterParameter="2">
                                                    <Binding Path="DataContext.SelectFileIndex" RelativeSource="{RelativeSource FindAncestor,AncestorType=UserControl}" Mode="OneWay"/>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" Mode="OneWay"/>
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>